// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User System
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Hashed
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userSettings   UserSettings[]
  yearlyGoals    YearlyGoal[]
  monthlyGoals   MonthlyGoal[]
  weeklyPlans    WeeklyPlan[]
  dailyPlans     DailyPlan[]
  recurringTasks RecurringTask[]
  notes          Note[]
}

// Global Settings (Now UserSettings)
model UserSettings {
  id            String   @id @default(uuid())
  ultimateGoal  String   @default("")
  planningYears String   @default("[]") // JSON string of number[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Goals
model YearlyGoal {
  id          String   @id @default(uuid())
  year        Int
  specific    String   @default("")
  measurable  String   @default("")
  achievable  String   @default("")
  relevant    String   @default("")
  timeBound   String   @default("")
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MonthlyGoal {
  id        String   @id @default(uuid())
  text      String
  month     Int // 0-11
  year      Int
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Weekly Plan
model WeeklyPlan {
  id        String       @id @default(uuid())
  weekStart String // ISO date string YYYY-MM-DD
  bigGoal   String       @default("")
  tasks     WeeklyTask[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Combined unique constraint for user + weekStart (if required later, but for now unique weekStart is risky if multiple users have same week. We should remove the simple unique weekStart or make it compound)
  // @@unique([weekStart]) -> REPLACED by compound below (optional for now, let's just drop the unique constraint or make it compound globally?)
  // For SQLite, simple unique is global. We need compound [userId, weekStart].
  // But userId is currently optional. This is tricky.
  // STRATEGY: Remove the @unique([weekStart]) constraint for now to allow multiple users to have same weekStart.
}

model WeeklyTask {
  id           String     @id @default(uuid())
  text         String
  completed    Boolean    @default(false)
  frequency    String? // "daily", "weekly", etc (RecurrenceFrequency)
  weeklyPlanId String
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
}

// Daily Plan
model DailyPlan {
  id               String         @id @default(uuid())
  date             String // ISO date string YYYY-MM-DD
  sections         DailySection[]
  reviewWhatDidIDo String         @default("")
  reviewMovedFwd   String         @default("")
  reviewDidntWork  String         @default("")
  reviewFocusTmw   String         @default("")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Similarly, remove global unique date constraint
  // @@unique([date])
}

model DailySection {
  id          String      @id @default(uuid())
  title       String
  dailyPlanId String
  dailyPlan   DailyPlan   @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  tasks       DailyTask[]
}

model DailyTask {
  id             String       @id @default(uuid())
  text           String
  completed      Boolean      @default(false)
  frequency      String?
  dailySectionId String
  dailySection   DailySection @relation(fields: [dailySectionId], references: [id], onDelete: Cascade)
}

// Recurring Tasks
model RecurringTask {
  id        String   @id @default(uuid())
  text      String
  frequency String // "daily", "weekly", "monthly", "yearly"
  time      String? // HH:MM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Notes
model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
